  "type-check": "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0442\u0438\u043F\u043E\u0432",
  check: "\u0412\u0441\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438",
  dev: "Dev-\u0441\u0435\u0440\u0432\u0435\u0440",
  start: "\u0417\u0430\u043F\u0443\u0441\u043A",
  format: "\u0424\u043E\u0440\u043C\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435",
  fmt: "\u0424\u043E\u0440\u043C\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435",
  e2e: "E2e-\u0442\u0435\u0441\u0442\u044B",
  ci: "CI \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E",
  verify: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430"
};
var isRussian = (language) => /^(ru|russian|рус)/i.test(language);
var title = (name, language) => {
  const [base, rest] = name.split(/[:-](.+)/);
  const t = (isRussian(language) ? titlesRu : titlesEn)[base ?? name] ?? name;
  return rest ? `${t} (${rest})` : t;
};
var packageManager = async (io) => {
  if (await io.exists("pnpm-lock.yaml")) return "pnpm";
  if (await io.exists("yarn.lock")) return "yarn";
  if (await io.exists("bun.lockb") || await io.exists("bun.lock")) return "bun";
  return "npm";
};
var scriptCommand = (pm, name) => {
  if (pm === "npm") return name === "test" || name === "start" ? `npm ${name}` : `npm run ${name}`;
  if (pm === "bun") return `bun run ${name}`;
  return `${pm} ${name}`;
};
var scanCommands = async (io, language = "auto") => {
  const ops = [];
  const add = (name, cmd, detail, file, anchor) => ops.push({
    op: "add",
    type: "command",
    title: title(name, language),
    content: `\`${cmd}\`${detail ? ` \u2014 ${isRussian(language) ? detail.replace(/^runs /, "\u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442 ") : detail}` : ""}`,
    evidence: [{ file, anchor }],
    confidence: 0.85
  });
  const pkg = await io.read("package.json");
  if (pkg) {
    try {
      const scripts = JSON.parse(pkg).scripts ?? {};
      const pm = await packageManager(io);
      for (const [name, body] of Object.entries(scripts)) {
        if (!USEFUL.test(name)) continue;
        add(name, scriptCommand(pm, name), `runs \`${body}\``, "package.json", `scripts.${name}`);
      }
    } catch {
    }
  }
  for (const [file, runner] of [
    ["Makefile", "make"],
    ["justfile", "just"]
  ]) {
    const text = await io.read(file);
    if (!text) continue;
    for (const m of text.matchAll(/^([A-Za-z0-9_-]+):(?!=)/gm)) {
      const name = m[1];
      if (USEFUL.test(name)) add(name, `${runner} ${name}`, "", file, name);
    }
  }
  if (await io.exists("Cargo.toml")) {
    add("build", "cargo build", "", "Cargo.toml", "package");
    add("test", "cargo test", "", "Cargo.toml", "package");
  }
  if (await io.exists("go.mod")) add("test", "go test ./...", "", "go.mod", "module");
  return ops;
};

// src/core/maintenance.ts
var lint = async (io, entries, config) => {
  const out = [];
  const active = activeEntries(entries);
  for (let i = 0; i < active.length; i++)
    for (let j = i + 1; j < active.length; j++) {
      const a = active[i];
      const b = active[j];
      if (a.type !== b.type) continue;
      const sim = jaccard(`${a.title} ${a.content}`, `${b.title} ${b.content}`);
      if (sim >= 0.45) out.push({ level: "warn", text: `\`${a.id}\` and \`${b.id}\` say much the same (${Math.round(sim * 100)}%): merge, or one contradicts the other` });
      else if (a.type === "command" && a.title.toLowerCase() === b.title.toLowerCase())
        out.push({ level: "warn", text: `\`${a.id}\` and \`${b.id}\` are both "${a.title}" with different commands: which one is right?` });
    }
  for (const id of await findStale(io, entries)) out.push({ level: "warn", text: `\`${id}\` is stale: every file it cites is gone` });
  const usage = await loadUsage(io);
  for (const e of active) {
    if (e.type === "decision" && !e.rationale) out.push({ level: "warn", text: `\`${e.id}\` is a decision without a reason` });
    if ((usage[e.id]?.harmful ?? 0) > (usage[e.id]?.helpful ?? 0)) out.push({ level: "warn", text: `\`${e.id}\` was judged wrong more often than helpful` });
    if (!e.evidence.some((v) => v.file) && e.type !== "decision") out.push({ level: "info", text: `\`${e.id}\` cites no file: it cannot go stale when the code changes` });
  }
  const core = renderCore([...entries.values()], config);
  const omitted = core.match(/(\d+) more in `/);
  if (omitted) out.push({ level: "warn", text: `${omitted[1]} entries do not fit in ${PATHS.coreRule} (${config.budgets.coreLines} lines): scope some to paths, or retire some` });
  return out;
};
var WEEK = 7 * 864e5;

// src/adapters/antigravity/hooks.ts
import { mkdir as mkdir4, open, readdir as readdir2, readFile as readFile4 } from "node:fs/promises";
import { join as join5 } from "node:path";
var collectionStats = async (root) => {
  const dir = join5(root, BASE, "events");
  const sessions = await readdir2(dir).catch(() => []);
  const counts = {};
  let total = 0;
  let validSessions = 0;
  for (const session of sessions) {
    if (!/^[a-f0-9]{32}$/.test(session)) continue;
    validSessions++;
    for (const file of await readdir2(join5(dir, session)).catch(() => [])) {
      if (!file.endsWith(".json")) continue;
      try {
        const e = JSON.parse(await readFile4(join5(dir, session, file), "utf8"));
        counts[e.event] = (counts[e.event] ?? 0) + 1;
        total++;
      } catch {
      }
    }
  }
  const io = nodeIo(root, "antigravity");
  const config = await loadConfig(io);
  const tasks = await io.list(`${BASE}/tasks`);
  const budgets = (await io.list(BASE)).filter((n) => /^budget-.*\.json$/.test(n));
  let modelCalls = 0;
  for (const name of budgets) {
    try {
      modelCalls += Number(JSON.parse(await io.read(`${BASE}/${name}`) ?? "{}").calls ?? 0);
    } catch {
    }
  }
  return {
    sessions: validSessions,
    events: total,
    counts,
    modelCallsUpperBound: modelCalls,
    contentCaptured: tasks.some((n) => n.endsWith(".json")),
    analysisEnabled: config.antigravity.enabled
  };
};

// src/adapters/antigravity/sidecar-api.ts
var fingerprint = (proposal) => createHash2("sha256").update(JSON.stringify(proposal.op)).digest("hex");
var proposalView = (proposal, entries) => {
  const op = proposal.op;
  const existing = "id" in op ? entries.get(op.id) : void 0;
  const types = {
    command: "\u041A\u043E\u043C\u0430\u043D\u0434\u0430",
    gotcha: "\u041B\u043E\u0432\u0443\u0448\u043A\u0430",
    decision: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435",
    procedure: "\u041F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430"
  };
  const changes = {
    update: "\u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0437\u0430\u043F\u0438\u0441\u0438",
    reinforce: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u0437\u0430\u043F\u0438\u0441\u0438",
    deprecate: "\u0423\u0434\u0430\u043B\u0435\u043D\u0438\u0435 \u0438\u0437 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445 \u0437\u043D\u0430\u043D\u0438\u0439"
  };
  return {
    id: proposal.id,
    fingerprint: fingerprint(proposal),
    human: needsHuman(op),
    kind: op.op === "add" ? types[op.type] : changes[op.op],
    title: op.op === "add" ? op.title : op.op === "update" ? op.title ?? existing?.title ?? op.id : existing?.title ?? op.id,
    content: op.op === "add" ? op.content : op.op === "update" ? op.content ?? existing?.content ?? "" : op.op === "deprecate" ? op.reason : "\u0417\u0430\u043F\u0438\u0441\u044C \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0430\u0441\u044C \u043F\u0440\u0438 \u0440\u0430\u0431\u043E\u0442\u0435 \u043D\u0430\u0434 \u0437\u0430\u0434\u0430\u0447\u0435\u0439.",
    ...op.op === "add" && op.rationale ? { rationale: op.rationale } : {},
    reason: proposal.reason?.replace(/^(?:codex|opencode|antigravity|adapter): review required$/i, "\u041E\u0436\u0438\u0434\u0430\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438").replaceAll("evidence file not found:", "\u041D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0449\u0438\u0439 \u0444\u0430\u0439\u043B:") ?? null
  };
};
