var toolOk = (text, structuredContent) => ({
  content: [{ type: "text", text }],
  structuredContent
});
var toolErr = (err) => {
  const message = err instanceof Error ? err.message : String(err);
  return {
    isError: true,
    content: [{ type: "text", text: message }],
    structuredContent: { ok: false, error: message }
  };
};
var callTool = async (name, args) => {
  try {
    switch (name) {
      case "archivist_panel": {
        const rootArg = typeof args.root === "string" && args.root.trim() ? args.root.trim() : void 0;
        const tabArg = typeof args.tab === "string" && ["entries", "proposals", "reports", "tools"].includes(args.tab) ? args.tab : void 0;
        const snap = await uiSnapshot({ root: rootArg });
        const summary = snap.root ? `Archivist (${snap.project}): ${snap.counts.entries} active entries, ${snap.counts.review} pending review, ${snap.counts.reports} reports.` : "Archivist panel opened. No project selected yet \u2014 pick or add a project path in the panel.";
        return toolOk(summary, { ...snap, ...tabArg ? { tab: tabArg } : {} });
      }
      case "panel_state": {
        const snap = await uiSnapshot({
          root: typeof args.root === "string" && args.root.trim() ? args.root.trim() : void 0,
          query: typeof args.q === "string" ? args.q : "",
          type: typeof args.type === "string" ? args.type : void 0
        });
        return toolOk("ok", { ok: true, ...snap });
      }
      case "panel_report": {
        if (typeof args.root !== "string" || !args.root.trim()) {
          return toolOk("\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u0440\u043E\u0435\u043A\u0442.", { ok: true, file: null, text: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u0440\u043E\u0435\u043A\u0442." });
        }
        const rep = await uiReport(args.root, typeof args.file === "string" ? args.file : void 0);
        return toolOk(rep.file ?? "no report", { ok: true, ...rep });
      }
      case "panel_init": {
        if (typeof args.root !== "string" || !args.root.trim()) throw new Error("\u041D\u0435 \u0443\u043A\u0430\u0437\u0430\u043D \u043F\u0443\u0442\u044C \u043A \u043F\u0440\u043E\u0435\u043A\u0442\u0443");
        const res = await uiInit(args.root);
        return toolOk(`\u0418\u043D\u0438\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043E \xB7 \u043A\u043E\u043C\u0430\u043D\u0434 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E: ${res.added}`, { ok: true, ...res });
      }
      case "panel_project": {
        if (typeof args.root !== "string" || !args.root.trim()) throw new Error("\u0423\u043A\u0430\u0436\u0438\u0442\u0435 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u044B\u0439 \u043F\u0443\u0442\u044C \u043A \u043F\u0440\u043E\u0435\u043A\u0442\u0443");
        const res = await uiRegisterProject(args.root);
        return toolOk(`\u041E\u0442\u043A\u0440\u044B\u0442 \u043F\u0440\u043E\u0435\u043A\u0442: ${res.root}`, { ok: true, ...res });
      }
      case "panel_settle": {
        if (typeof args.root !== "string") throw new Error("\u041D\u0435 \u0443\u043A\u0430\u0437\u0430\u043D \u043F\u0440\u043E\u0435\u043A\u0442");
        const action = args.action === "apply" || args.action === "skip" ? args.action : void 0;
        if (!action || typeof args.id !== "string" || typeof args.fingerprint !== "string") {
          throw new Error("\u041D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u044B\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F");
        }
        const res = await uiSettle(args.root, { id: args.id, fingerprint: args.fingerprint, action });
        return toolOk(res.text, { ok: true, ...res });
      }
      case "panel_add": {
        if (typeof args.root !== "string") throw new Error("\u041D\u0435 \u0443\u043A\u0430\u0437\u0430\u043D \u043F\u0440\u043E\u0435\u043A\u0442");
        const res = await uiAdd(args.root, {
          type: String(args.type ?? ""),
          title: String(args.title ?? ""),
          content: String(args.content ?? ""),
          rationale: typeof args.rationale === "string" ? args.rationale : void 0,
          paths: typeof args.paths === "string" ? args.paths : void 0
        });
        return toolOk(res.text, { ok: true, ...res });
      }
      case "panel_deprecate": {
        if (typeof args.root !== "string") throw new Error("\u041D\u0435 \u0443\u043A\u0430\u0437\u0430\u043D \u043F\u0440\u043E\u0435\u043A\u0442");
        const res = await uiDeprecate(args.root, {
          id: String(args.id ?? ""),
          reason: String(args.reason ?? "")
        });
        return toolOk(res.text, { ok: true, ...res });
      }
      case "panel_analysis": {
        if (typeof args.root !== "string") throw new Error("\u041D\u0435 \u0443\u043A\u0430\u0437\u0430\u043D \u043F\u0440\u043E\u0435\u043A\u0442");
        const action = args.action === "enable" || args.action === "disable" || args.action === "run" ? args.action : void 0;
        if (!action) throw new Error("\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0430\u043D\u0430\u043B\u0438\u0437\u0430");
        const res = await uiAnalysis(args.root, action);
        return toolOk(res.text, { ok: true, ...res });
      }
      case "panel_maintenance": {
        if (typeof args.root !== "string") throw new Error("\u041D\u0435 \u0443\u043A\u0430\u0437\u0430\u043D \u043F\u0440\u043E\u0435\u043A\u0442");
        const action = args.action === "render" || args.action === "lint" ? args.action : void 0;
        if (!action) throw new Error("\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F");
        const res = await uiMaintenance(args.root, action);
        return toolOk(res.text, { ok: true, ...res });
      }
      default:
        return toolErr(new Error(`Unknown tool: ${name}`));
    }
  } catch (err) {
    return toolErr(err);
  }
};
var defaultPanelHtmlPath = () => {
  if (process.env.ARCHIVIST_PANEL_HTML?.trim()) return process.env.ARCHIVIST_PANEL_HTML.trim();
  const here = dirname3(fileURLToPath(import.meta.url));
  return join6(here, "..", "ui", "panel.html");
};
var handleMcpMessage = async (msg, loadHtml = () => readFileSync(defaultPanelHtmlPath(), "utf8")) => {
  const method = msg.method;
  const hasId = msg.id !== void 0;
  if (!method) {
    return hasId ? { jsonrpc: "2.0", id: msg.id ?? null, error: { code: -32600, message: "Invalid Request" } } : void 0;
  }
  if (!hasId) return void 0;
  const id = msg.id ?? null;
  const params = msg.params && typeof msg.params === "object" ? msg.params : {};
  switch (method) {
    case "initialize": {
      const requested = typeof params.protocolVersion === "string" ? params.protocolVersion : "2025-03-26";
      return {
        jsonrpc: "2.0",
        id,
        result: {
          protocolVersion: requested,
          capabilities: {
            tools: { listChanged: false },
            resources: { subscribe: false, listChanged: false }
          },
          serverInfo: { name: "archivist-panel", version: MCP_SERVER_VERSION }
        }
      };
    }
    case "ping":
      return { jsonrpc: "2.0", id, result: {} };
    case "resources/list":
      return {
        jsonrpc: "2.0",
        id,
        result: {
          resources: [
            {
              uri: PANEL_RESOURCE_URI,
              name: "Archivist",
              description: "Live Archivist knowledge base panel",
              mimeType: PANEL_MIME_TYPE,
              _meta: { ui: { prefersBorder: false } }
            }
          ]
        }
      };
    case "resources/templates/list":
      return { jsonrpc: "2.0", id, result: { resourceTemplates: [] } };
    case "resources/read": {
      const uri = typeof params.uri === "string" ? params.uri : "";
      if (uri !== PANEL_RESOURCE_URI) {
        return { jsonrpc: "2.0", id, error: { code: -32002, message: `Resource not found: ${uri}` } };
      }
      try {
        const text = loadHtml();
        return {
          jsonrpc: "2.0",
          id,
          result: {
            contents: [
              {
                uri: PANEL_RESOURCE_URI,
                mimeType: PANEL_MIME_TYPE,
                text,
                _meta: { ui: { prefersBorder: false } }
              }
            ]
          }
        };
      } catch (err) {
        return {
          jsonrpc: "2.0",
          id,
          error: { code: -32603, message: err instanceof Error ? err.message : String(err) }
        };
      }
    }
    case "tools/list":
      return { jsonrpc: "2.0", id, result: { tools: MCP_TOOLS } };
    case "tools/call": {
      const toolName = typeof params.name === "string" ? params.name : "";
      const toolArgs = params.arguments && typeof params.arguments === "object" ? params.arguments : {};
      const result = await callTool(toolName, toolArgs);
      return { jsonrpc: "2.0", id, result };
    }
    default:
      return { jsonrpc: "2.0", id, error: { code: -32601, message: `Method not found: ${method}` } };
  }
};
var startBackgroundLoop = () => {
  let polling = false;
  setInterval(() => {
    if (polling) return;
    polling = true;
    void (async () => {
      try {
        const reg = await readRegistry();
        for (const proj of reg.projects.slice(0, 5)) {
          if (!existsSync5(proj.root)) continue;
          const io = nodeIo(proj.root, "antigravity");
          const cfg = await loadConfig(io);
          if (cfg.enabled && cfg.antigravity.enabled) {
            await runWorker(proj.root, void 0, { once: true });
          }
        }
      } catch {
      } finally {
        polling = false;
      }
    })();
  }, 5e3).unref();
};
var startMcpServer = () => {
  startBackgroundLoop();
  process.stdin.setEncoding("utf8");
  let buffer = "";
  const write = (res) => {
    process.stdout.write(JSON.stringify(res) + "\n");
  };
  const processLine = async (line) => {
    const trimmed = line.trim();
    if (!trimmed) return;
    let parsed;
    try {
      parsed = JSON.parse(trimmed);
    } catch {
      write({ jsonrpc: "2.0", id: null, error: { code: -32700, message: "Parse error" } });
      return;
    }
    try {
      const response = await handleMcpMessage(parsed);
      if (response) write(response);
    } catch (err) {
      if (parsed.id !== void 0) {
        write({
          jsonrpc: "2.0",
          id: parsed.id ?? null,
          error: { code: -32603, message: err instanceof Error ? err.message : String(err) }
        });
      }
    }
  };
  process.stdin.on("data", (chunk) => {
    buffer += chunk;
    let idx;
    while ((idx = buffer.indexOf("\n")) >= 0) {
      const line = buffer.slice(0, idx);
      buffer = buffer.slice(idx + 1);
      void processLine(line);
    }
  });
  process.stdin.on("end", () => {
    if (buffer.trim()) void processLine(buffer);
  });
};

// src/adapters/antigravity/mcp-entry.ts
startMcpServer();
