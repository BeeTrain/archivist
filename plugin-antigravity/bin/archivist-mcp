var uiAnalysis = async (rootInput, action) => {
  const root = findRoot(rootInput);
  const io = nodeIo(root, "antigravity");
  if (action === "enable" || action === "disable") {
    await withLock(io, async () => {
      const raw = JSON.parse(await io.read(PATHS.config) ?? "{}");
      const prev = raw.antigravity && typeof raw.antigravity === "object" ? raw.antigravity : {};
      await io.write(
        PATHS.config,
        JSON.stringify({ ...raw, antigravity: { ...prev, enabled: action === "enable" } }, null, 2) + "\n"
      );
    });
  } else if (action === "run") {
    await runWorker(root, void 0, { once: true });
  }
  const status = await analysisStatus(io);
  return {
    ...status,
    text: action === "enable" ? "\u0424\u043E\u043D\u043E\u0432\u044B\u0439 \u0430\u043D\u0430\u043B\u0438\u0437 \u0432\u043A\u043B\u044E\u0447\u0451\u043D" : action === "disable" ? "\u0424\u043E\u043D\u043E\u0432\u044B\u0439 \u0430\u043D\u0430\u043B\u0438\u0437 \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D" : "\u041E\u0447\u0435\u0440\u0435\u0434\u044C \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u0430"
  };
};
var uiMaintenance = async (rootInput, action) => {
  const io = nodeIo(findRoot(rootInput), "antigravity");
  const config = await loadConfig(io);
  if (action === "render") {
    const r = await withLock(io, async () => renderAll(io, (await loadState(io)).entries, config));
    const lines2 = [...r.written.map((w) => `+ ${w}`), ...r.removed.map((w) => `- ${w}`)];
    return { text: lines2.length ? `\u041F\u0435\u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043E \u0444\u0430\u0439\u043B\u043E\u0432: ${lines2.length}` : "\u0412\u0441\u0435 \u0444\u0430\u0439\u043B\u044B \u0443\u0436\u0435 \u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B", lines: lines2 };
  }
  const findings = await lint(io, (await loadState(io)).entries, config);
  const lines = findings.map((f) => `${f.level === "warn" ? "\u26A0" : "\xB7"} ${f.text}`);
  return { text: lines.length ? `\u041D\u0430\u0445\u043E\u0434\u043E\u043A lint: ${lines.length}` : "\u0417\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u0439 lint \u043D\u0435\u0442", lines };
};
var uiRegisterProject = async (rootInput, conversationId) => {
  const abs = resolve3(rootInput.trim());
  if (!abs || !existsSync4(abs)) throw new Error(`\u041F\u0430\u043F\u043A\u0430 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u0430: ${rootInput}`);
  const root = findRoot(abs);
  await registerWorkspace(root, conversationId);
  return { root };
};

