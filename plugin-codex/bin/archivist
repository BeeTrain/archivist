<main id="list" aria-label="\u0417\u0430\u043F\u0438\u0441\u0438 Archivist"></main>
<script>${script}</script></body></html>`;
    startPanel = async (io) => {
      const token = randomBytes(24).toString("hex");
      const prefix = `/${token}/`;
      const hash2 = createHash2("sha256").update(script).digest("base64");
      const server = createServer(async (req, res) => {
        res.setHeader("Cache-Control", "no-store");
        res.setHeader("Referrer-Policy", "no-referrer");
        res.setHeader("X-Content-Type-Options", "nosniff");
        res.setHeader("Content-Security-Policy", `default-src 'none'; script-src 'sha256-${hash2}'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'`);
        if (req.method !== "GET") {
          res.writeHead(405).end();
          return;
        }
        if (req.url !== prefix && req.url !== `${prefix}state`) {
          res.writeHead(404).end();
          return;
        }
        try {
          if (req.url === prefix) {
            res.setHeader("Content-Type", "text/html; charset=utf-8");
            res.end(panelHtml);
          } else {
            const data = await panelSnapshot(io);
            res.setHeader("Content-Type", "application/json; charset=utf-8");
            res.end(JSON.stringify(data));
          }
        } catch {
          res.writeHead(503).end();
        }
      });
      await new Promise((resolve2, reject) => {
        server.once("error", reject);
        server.listen(0, "127.0.0.1", () => {
          server.off("error", reject);
          resolve2();
        });
      });
      const address = server.address();
      if (!address || typeof address === "string") throw new Error("Panel did not start");
      return { server, url: `http://127.0.0.1:${address.port}${prefix}` };
    };
  }
});

// src/cli/main.ts
var main_exports = {};
import { execFileSync } from "node:child_process";
var HELP, MIN_CLAUDE, now, readDocs, printOutcomes, printRender, init, status, report, options, add, change, review, baseline, gc, claudeVersion, doctor, main;
var init_main = __esm({
  async "src/cli/main.ts"() {
    "use strict";
    init_config();
    init_io();
    init_ledger();
    init_lock();
    init_render();
    init_args();
    init_review();
    init_types();
    init_validate();
    init_signals();
    init_transcript();
    init_maintenance();
    init_memory();
    init_metrics();
    init_node_io();
    init_scan();
    init_panel();
    HELP = `archivist \u2014 project knowledge from coding-agent sessions

Usage: archivist <command> [--root <dir>]

  init                  set up .archivist/ and seed exact build/test/lint commands from the project's manifests
  status                what is recorded: entries by type, proposals waiting for review
  panel                 open a live local dashboard (prints its URL; keep the process running)
  report [file]         print the latest task report, or the given one
  review [--json]       list the proposals waiting for review (--json: with stable ids, for the triage skill)
  apply <n|id|1,3|all>  record proposals as they are
  skip <n|id|1,3|all>   drop proposals; the same idea is not proposed again
  add --type <command|gotcha|decision|procedure> --title <t> --content <c> [--why <reason>] [--paths <glob,glob>] [--evidence <file,file>]
                        record a fact by hand (decisions need --why)
  edit <id> [--title <t>] [--content <c>] [--why <reason>] [--paths <glob,glob>|--paths ""]
                        fix a recorded entry; an empty --paths makes it apply everywhere
  deprecate <id> --reason <why>
                        retire an entry: it leaves the rules, the ledger keeps it with the reason
  recall <words>        the recorded entries that match: ask this before exploring
  baseline [--before <date>]
                        measure the project's Claude Code sessions before Archivist (from their transcripts)
  stats                 recent tasks against the baseline, and how each entry fares
  health                one look at how Archivist is doing here, and what to do about it
  gc [--days 60] [--apply]
                        entries with no sign of use for that long; --apply retires them
  lint                  near-duplicates, contradictions, stale entries, decisions without a reason, budgets
  render                regenerate the rule files, index and ADRs from the ledger
  doctor                check the setup
  uninstall [--purge]   remove what Archivist generated (rules, skills); --purge also removes .archivist/
`;
    MIN_CLAUDE = [2, 1, 290];
    now = () => (/* @__PURE__ */ new Date()).toISOString();
    readDocs = async (io) => {
      const out = [];
      for (const p of ["CLAUDE.md", ".claude/CLAUDE.md", "AGENTS.md", "README.md"]) {
        const t = await io.read(p);
        if (t) out.push(t);
      }
      return out;
    };
    printOutcomes = (outcomes) => {
      for (const o of outcomes) {
        const what = o.op.op === "add" ? o.op.title : o.title ?? ("id" in o.op ? o.op.id : "");
        console.log(`  ${o.reason && !o.id ? "\xB7" : o.op.op === "reinforce" ? "\u2191" : "+"} [${o.type ?? "?"}] ${what}${o.reason ? ` (${o.reason})` : ""}`);
      }
    };
    printRender = (r) => {
      for (const w of r.written) console.log(`  wrote ${w}`);
      for (const w of r.removed) console.log(`  removed ${w}`);
    };
    init = async (io) => withLock(io, async () => {
      if (!await io.exists(PATHS.config)) await io.write(PATHS.config, JSON.stringify(DEFAULT_CONFIG, null, 2) + "\n");
      if (!await io.exists(PATHS.gitignore)) await io.write(PATHS.gitignore, ".local/\n");
      const config = await loadConfig(io);
      const state = await loadState(io);
      const v = await validateOps({ ops: await scanCommands(io, config.language), entries: state.entries, io, config, docs: await readDocs(io), now: now(), source: "init" });
      await appendLedger(io, v.records);
      console.log(`Archivist set up in ${io.root}`);
      printOutcomes([...v.applied, ...v.rejected]);
      if (!v.applied.length) console.log("  no new commands found to record");
      printRender(await renderAll(io, (await loadState(io)).entries, config));
      console.log(`Commit .archivist/${io.target === "codex" ? " and .agents/skills/" : " and .claude/rules/archivist/"} to share the knowledge with your team.`);
    });
    status = async (io) => {
      const state = await loadState(io);
      const active = activeEntries(state.entries);
      const by = (t) => active.filter((e) => e.type === t).length;
      const proposals = await listProposals(io);
      const reports = (await io.list(PATHS.reports)).sort();
      console.log(`${active.length} active entries: ${by("command")} commands, ${by("gotcha")} gotchas, ${by("decision")} decisions`);
      console.log(`${state.entries.size - active.length} deprecated`);
      console.log(`${proposals.length} proposals waiting for review (archivist review)`);
      console.log(reports.length ? `latest report: ${PATHS.reports}/${reports.at(-1)}` : "no reports yet");
    };
    report = async (io, which) => {
      const reports = (await io.list(PATHS.reports)).sort();
      const file = which ?? (reports.length ? `${PATHS.reports}/${reports.at(-1)}` : void 0);
      const text = file ? await io.read(file) : void 0;
      console.log(text ?? "No report yet: Archivist writes one after a task that taught something.");
    };
    options = (args) => parseOptions(args).opts;
    add = async (io, args) => {
      const o = options(args);
      const type = o.type;
      if (!ENTRY_TYPES.includes(type) || !o.title || !o.content) {
        console.error("add needs --type command|gotcha|decision, --title and --content");
        return 2;
      }
      if (type === "decision" && !o.why) {
        console.error("a decision needs --why: the reason, and what was rejected");
        return 2;
      }
      const outcomes = await addEntry(
        io,
        await loadConfig(io),
        { type, title: o.title, content: o.content, ...o.why ? { rationale: o.why } : {}, paths: commaList(o.paths), evidence: commaList(o.evidence) },
        now()
      );
      printOutcomes(outcomes);
      return outcomes.some((x) => x.id) ? 0 : 1;
    };
    change = async (io, verb, args) => {
      const { words, opts } = parseOptions(args);
      const id = words[0];
      if (!id) {
        console.error(`${verb} needs an entry id (see .archivist/INDEX.md or archivist recall)`);
        return 2;
      }
      const config = await loadConfig(io);
      const r = verb === "deprecate" ? await deprecateEntry(io, config, id, opts.reason ?? "", now()) : await editEntry(io, config, id, editFromOptions(opts), now());
      if (!r.ok) {
        console.error(r.reason);
        return 1;
      }
      console.log(`${verb === "edit" ? "~" : "\u2212"} [${r.entry.type}] ${r.entry.title} \`${r.entry.id}\``);
      printRender(r);
      return 0;
    };
    review = async (io, verb, which) => {
      const proposals = await listProposals(io);
      const chosen = which ? pick(proposals, which) : [];
      if (!chosen.length) {
        console.error(`${verb} needs proposal numbers from \`archivist review\` (or all)`);
        return 2;
      }
      if (verb === "skip") console.log(`skipped ${await skipProposals(io, chosen, now())} proposal(s)`);
      else printOutcomes(await applyProposals(io, await loadConfig(io), chosen, now()));
      return 0;
    };
    baseline = async (io, args) => {
      const o = options(args);
      const created = [...(await loadState(io)).entries.values()].map((e) => e.created).sort()[0];
      const before = new Date(o.before ?? created ?? now());
      const { sessions, segments } = await readProjectSegments(io.root, before);
      const metrics = segments.map((s) => toMetrics(computeSignals(s), new Date(s.startedAt).toISOString(), "baseline"));
      const b = { createdAt: now(), before: before.toISOString(), sessions, summary: summarize(metrics) };
      await io.write(BASELINE, JSON.stringify(b, null, 2) + "\n");
      console.log(`Baseline: ${b.summary.tasks} tasks from ${sessions} sessions before ${b.before.slice(0, 10)} (${transcriptDir(io.root)})`);
      console.log(compareText(void 0, b.summary).replace(/^No baseline yet.*\n\n/, "").replace("now (", "before ("));
    };
    gc = async (io, args) => {
      const o = options(args);
      const days = Number(o.days ?? 60);
      const state = await loadState(io);
      const quiet = await gcCandidates(io, state.entries, days, /* @__PURE__ */ new Date());
      if (!(await loadConfig(io)).rules.files)
        console.log("Rule files are off, so no rule load counts as use: unused here means no recorded command was run and no task judged the entry.");
      if (!quiet.length) {
        console.log(`Every entry showed a sign of use in the last ${days} days.`);
        return;
      }
      for (const e of quiet) console.log(`  \`${e.id}\` [${e.type}] ${e.title}`);
      if (!args.includes("--apply")) {
        console.log(`${quiet.length} entries unused for ${days} days. Run with --apply to retire them (they stay in the ledger).`);
        return;
      }
      const retired = await withLock(io, async () => {
        const entries = (await loadState(io)).entries;
        const still = quiet.filter((e) => entries.get(e.id)?.status === "active");
        await appendLedger(io, gcRecords(still, days, now()));
        printRender(await renderAll(io, (await loadState(io)).entries, await loadConfig(io)));
        return still.length;
      });
      console.log(`retired ${retired} entries`);
    };
    claudeVersion = () => {
      try {
        const out = execFileSync("claude", ["--version"], { encoding: "utf8", timeout: 1e4 });
        const m = out.match(/(\d+)\.(\d+)\.(\d+)/);
        return m ? [Number(m[1]), Number(m[2]), Number(m[3])] : void 0;
      } catch {
        return void 0;
      }
    };
    doctor = async (io) => {
      let ok = true;
      const check = (pass, msg, hint) => {
        console.log(`${pass ? "\u2714" : "\u2718"} ${msg}${!pass && hint ? `
    ${hint}` : ""}`);
        ok &&= pass;
      };
      const node = Number(process.versions.node.split(".")[0]);
      check(node >= 20, `Node ${process.versions.node}`, "Archivist's CLI needs Node 20 or newer");
      const v = io.target === "codex" ? void 0 : claudeVersion();
      if (v) {
        const recent = v[0] > MIN_CLAUDE[0] || v[0] === MIN_CLAUDE[0] && (v[1] > MIN_CLAUDE[1] || v[1] === MIN_CLAUDE[1] && v[2] >= MIN_CLAUDE[2]);
        check(recent, `Claude Code ${v.join(".")}`, `the Archivist mod needs Claude Code ${MIN_CLAUDE.join(".")} or newer`);
      } else if (io.target !== "codex") console.log("\xB7 claude not on PATH (fine inside the desktop app; the CLI checks are skipped)");
      check(await io.exists(PATHS.dir), `${PATHS.dir}/ exists`, "run `archivist init`");
      const configText = await io.read(PATHS.config);
      let configOk = true;
      if (configText) {
        try {
          JSON.parse(configText);
        } catch {
          configOk = false;
        }
      }
      check(configOk, `${PATHS.config} ${configText ? "parses" : "absent (defaults apply)"}`, "fix the JSON or delete the file");
      const state = await loadState(io);
      check(!state.badLines.length, `ledger: ${state.entries.size} entries`, `unreadable lines: ${state.badLines.join(", ")}`);
      const config = await loadConfig(io);
      const rulesDir = io.target === "codex" ? ".archivist/codex/rules" : PATHS.rulesDir;
      for (const name of (await io.list(rulesDir)).filter((n) => n.endsWith(".md"))) {
        const path = `${rulesDir}/${name}`;
        const text = await io.read(path) ?? "";
        const lines = text.split("\n").length - 1;
        const core = name === "core.md";
        const budget = core ? config.budgets.coreLines : config.budgets.pathFileLines + 6;
        const chars = core ? config.budgets.coreChars : config.budgets.pathFileChars + 400;
        check(lines <= budget && text.length <= chars, `${path}: ${lines}/${budget} lines, ${text.length}/${chars} chars`, "run `archivist render`");
      }
      const stale = await findStale(io, state.entries);
      check(!stale.size, `${stale.size} stale entries (cited files are gone)`, `review them in ${PATHS.index}: update or deprecate`);
      return ok;
    };
    main = async () => {
      const args = process.argv.slice(2);
      const rootAt = args.indexOf("--root");
      const start = rootAt >= 0 ? args.splice(rootAt, 2)[1] : process.cwd();
      const targetAt = args.indexOf("--target");
      const target2 = targetAt >= 0 ? args.splice(targetAt, 2)[1] : process.env.ARCHIVIST_TARGET ?? "claude";
      if (target2 !== "claude" && target2 !== "codex") throw new Error("--target must be claude or codex");
      const [cmd, ...rest] = args;
      const io = nodeIo(findRoot(start ?? process.cwd()), target2);
      switch (cmd) {
        case "panel": {
          const { url } = await startPanel(io);
          console.log(url);
          return 0;
        }
        case "init":
          await init(io);
          return 0;
        case "status":
          await status(io);
          return 0;
        case "report":
          await report(io, rest[0]);
          return 0;
        case "review":
          console.log(rest.includes("--json") ? reviewJson(await listProposals(io)) : reviewText(await listProposals(io)));
          return 0;
        case "apply":
        case "skip":
          return review(io, cmd, rest.join(","));
        case "add":
          return add(io, rest);
        case "edit":
        case "deprecate":
          return change(io, cmd, rest);
        case "render":
          printRender(await withLock(io, async () => renderAll(io, (await loadState(io)).entries, await loadConfig(io))));
          return 0;
        case "recall":
          console.log(recallText((await loadState(io)).entries, rest.join(" ")));
          return 0;
        case "baseline":
          if (io.target === "codex") throw new Error("Codex baseline is not available yet");
          await baseline(io, rest);
          return 0;
        case "stats":
          console.log(await statsText(io, (await loadState(io)).entries));
          return 0;
        case "health":
          console.log(await healthText(io, (await loadState(io)).entries, await loadConfig(io), /* @__PURE__ */ new Date()));
          return 0;
        case "gc":
          await gc(io, rest);
          return 0;
        case "lint": {
          const findings = await lint(io, (await loadState(io)).entries, await loadConfig(io));
          for (const f of findings) console.log(`${f.level === "warn" ? "\u2718" : "\xB7"} ${f.text}`);
          if (!findings.length) console.log("\u2714 nothing to report");
          return findings.some((f) => f.level === "warn") ? 1 : 0;
        }
        case "doctor":
          return await doctor(io) ? 0 : 1;
        case "uninstall": {
          const inMemory = (await loadMemoryCaches(io)).filter((m) => Object.keys(m.items).length);
          const removed = await uninstall(io.root, rest.includes("--purge"), io.target);
          for (const m of inMemory)
            console.log(`Entries also live in ${m.store} memory (project ${m.project}): run /archivist memory clear in a Claude Code session to remove them.`);
          for (const r of removed) console.log(`  removed ${r}`);
          if (!removed.length) console.log("Nothing generated by Archivist here.");
          if (!rest.includes("--purge")) console.log(`Kept ${PATHS.dir}/ (the ledger is the knowledge itself): add --purge to remove it too.`);
          console.log(io.target === "codex" ? "Disable or uninstall Archivist in Codex plugin settings." : "To remove the plugin from Claude Code: /plugin uninstall archivist@archivist");
          return 0;
        }
        case void 0:
        case "help":
        case "--help":
        case "-h":
          console.log(HELP);
          return 0;
        default:
          console.error(`unknown command: ${cmd}

${HELP}`);
          return 2;
      }
    };
    process.exitCode = await main();
  }
});

// src/adapters/codex/hooks.ts
init_config();
init_ledger();
init_render();
init_privacy();
init_node_io();
init_lock();
import { createHash } from "node:crypto";
import { mkdir as mkdir2, open, readdir as readdir2, readFile as readFile2 } from "node:fs/promises";
import { join as join2 } from "node:path";
var EVENTS = /* @__PURE__ */ new Set(["SessionStart", "UserPromptSubmit", "PostToolUse", "Stop", "Interrupt", "SessionEnd"]);
var hash = (s) => createHash("sha256").update(s).digest("hex").slice(0, 32);
var capture = (input, excluded, at = (/* @__PURE__ */ new Date()).toISOString()) => {
  if (typeof input.hook_event_name !== "string" || !EVENTS.has(input.hook_event_name) || typeof input.session_id !== "string") return;
  const args = input.tool_input && typeof input.tool_input === "object" ? input.tool_input : {};
  const files = [];
  if (input.tool_name === "apply_patch" && typeof args.command === "string") {
    for (const m of args.command.matchAll(/^\*\*\* (?:Add|Update|Delete) File: (.+)$/gm)) {
      const path = m[1].trim();
      if (!path.startsWith("/") && !path.split("/").includes("..") && !isExcluded(path, excluded)) files.push(path);
    }
  }
  return {
    v: 1,
    event: input.hook_event_name,
    session: hash(input.session_id),
    at,
    ...typeof input.turn_id === "string" ? { turn: hash(input.turn_id) } : {},
    ...typeof input.tool_name === "string" ? { tool: input.tool_name.slice(0, 200) } : {},
    ...typeof input.tool_use_id === "string" ? { call: hash(input.tool_use_id) } : {},
    fields: Object.keys(input).sort().slice(0, 50),
    files: [...new Set(files)].slice(0, 100)
  };
};
var handleHook = async (input) => {
  if (process.env.ARCHIVIST_CHILD || typeof input.cwd !== "string") return {};
  const io = nodeIo(findRoot(input.cwd), "codex");
  const config = await loadConfig(io);
  if (!config.enabled) return {};
  const event = capture(input, config.privacy.excludePaths);
  if (!event) return {};
  await io.write(".archivist/.local/codex/collector.json", JSON.stringify({ v: 1, contentCaptured: false }) + "\n");
  const dir = join2(io.root, ".archivist/.local/codex/events", event.session);
  await mkdir2(dir, { recursive: true, mode: 448 });
  const identity = event.call ? `${event.event}:${event.call}` : event.turn ? `${event.event}:${event.turn}` : `${event.event}:${event.at}`;
  const file = await open(join2(dir, `${hash(identity)}.json`), "wx", 384).catch((e) => {
    if (e.code !== "EEXIST") throw e;
    return void 0;
  });
  if (file) {
    try {
      await file.writeFile(JSON.stringify(event) + "\n");
    } finally {
      await file.close();
    }
  }
  if (event.event === "SessionStart") {
    const text = await withLock(io, async () => {
      const state = await loadState(io);
      const result = await renderAll(io, state.entries, config);
      return renderCore([...state.entries.values()], config, result.stale);
    });
    return { hookSpecificOutput: { hookEventName: "SessionStart", additionalContext: `${text}
Scoped knowledge: use the Archivist recall skill before exploring.
` } };
  }
  return {};
};
var collectionSummary = async (root) => {
  const dir = join2(root, ".archivist/.local/codex/events");
  const sessions = await readdir2(dir).catch(() => []);
  const counts = {};
  let total = 0;
  for (const session of sessions) {
    if (!/^[a-f0-9]{32}$/.test(session)) continue;
    for (const file of await readdir2(join2(dir, session))) {
      if (!file.endsWith(".json")) continue;
      try {
        const e = JSON.parse(await readFile2(join2(dir, session, file), "utf8"));
        counts[e.event] = (counts[e.event] ?? 0) + 1;
        total++;
      } catch {
      }
    }
  }
  return JSON.stringify({ sessions: sessions.length, events: total, counts, modelCalls: 0, contentCaptured: false }, null, 2);
};

// src/adapters/codex/entry.ts
init_node_io();
process.env.ARCHIVIST_TARGET = "codex";
if (process.argv[2] === "hook") {
  try {
    let raw = "";
    for await (const chunk of process.stdin) {
      raw += chunk;
      if (Buffer.byteLength(raw) > 4e6) throw new Error("Hook payload exceeds 4 MB");
    }
    console.log(JSON.stringify(await handleHook(JSON.parse(raw))));
  } catch {
    console.error("Archivist hook failed; collection skipped for this event.");
    console.log("{}");
  }
} else if (process.argv[2] === "collection") {
  console.log(await collectionSummary(findRoot(process.cwd())));
} else {
  await init_main().then(() => main_exports);
}
